# =============================================================
# 10-Steps-to-Self 环境变量（§13.2.2）
# 复制为 .env 后填值。.env 已在 .gitignore 中，绝不入仓。
# 本文件只写变量名与说明，不写真实值。
# =============================================================

# ---- 运行档位（§13.2.1）----
# cloud  = LLM 云端 + 嵌入云端（起步默认）
# hybrid = LLM 云端 + 用户历史嵌入走本地（推荐生产，隐私最优）
# local  = 全本地（仅开发/CI/演示，无 STRONG 能力）
RUNTIME_PROFILE=cloud

# ---- LLM（OpenAI 兼容协议；DeepSeek 与本地模型共用同一 adapter）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=180

# ---- 备用供应商（决策 #24；缺失则 STRONG 降级末端为显式失败）----
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- 本地 LLM（Ollama / vLLM / minimind serve）----
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
# toy = 仅冒烟（minimind）；fast = 指令微调 7B 级模型
# 绝不允许填 strong —— 启动自检会硬失败（§2.4.3）
LOCAL_LLM_TIER=toy

# ---- Embedding（云：智谱）----
EMBED_API_KEY=
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBED_DIM_NATIVE=2048
EMBED_TARGET_DIM=1024
EMBED_BATCH_SIZE=32

# ---- Embedding（本地）----
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_EMBED_DEVICE=cpu

# ---- Reranker（仅本地；先做 §7.5 消融再决定开启）----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=false
RERANKER_TIMEOUT_MS=800

# ---- 向量库 ----
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_KB=kb_zhipu1024_v1
CHROMA_COLLECTION_USER_PREFIX=mem_

# ---- 存储 ----
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=

# ---- 知识库构建（离线 CLI 专用，绝不接触用户数据，§7.7）----
BOCHA_API_KEY=
TAVILY_API_KEY=
OPENALEX_BASE=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_DAILY_CREDITS=10000
KB_CACHE_DIR=./data/kb_cache

# ---- 安全与合规 ----
POLICY_VERSION=2026-09-01
CRISIS_RESOURCES_FILE=config/crisis_resources.yaml
SESSION_RETENTION_DAYS=90

# ---- 可观测 ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
# 记录用户原话：仅调试且需用户授权（§11.1 隐私红线）
DEBUG_LOG_RAW_TEXT=false
